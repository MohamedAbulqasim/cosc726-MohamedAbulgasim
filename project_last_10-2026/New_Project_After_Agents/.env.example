# ==============================================================================
# COSC726 Agentic Artificial Intelligence Project
# Environment Variables & Model Provider Configuration
# Copy this file to .env before running: cp .env.example .env
# NOTE: The real .env is ignored by git and must NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE MODEL PROVIDER SWITCHES (The two variables that switch provider)
# ------------------------------------------------------------------------------
# MODEL_PROVIDER Options:
#   - deterministic : (Default) ADA 2024/2026 Clinical Expert Engine.
#                     Runs 100% locally. Zero cost, zero latency, NO API key, NO network required.
#   - ollama        : Local LLM runtime (e.g. LLaMA 3, Mistral) via Ollama server.
#   - gemini        : Hosted Google Gemini API (gemini-2.5-flash / gemini-1.5-pro).
#   - openai        : Hosted OpenAI API (gpt-4o-mini / gpt-4o).
#   - deepseek      : DeepSeek API (deepseek-chat / deepseek-reasoner).
#   - cohere        : Hosted Cohere API (command-r-plus).
MODEL_PROVIDER=deterministic

# LLM_MODEL Options:
#   - For deterministic : ada-clinical-expert-2026
#   - For ollama        : llama3:8b, mistral:7b, qwen2.5:7b
#   - For gemini        : gemini-2.5-flash, gemini-1.5-pro
#   - For openai        : gpt-4o-mini, gpt-4o
#   - For deepseek      : deepseek-chat
#   - For cohere        : command-r-plus-08-2024
LLM_MODEL=ada-clinical-expert-2026

# ------------------------------------------------------------------------------
# 2. LOCAL RUNTIME SETTINGS (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. HOSTED API KEYS (Leave dummy values if using deterministic or ollama)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# ------------------------------------------------------------------------------
# 4. SYSTEM & CLINICAL AUDIT SETTINGS
# ------------------------------------------------------------------------------
CLINICAL_EMERGENCY_THRESHOLD_GLUCOSE=250.0
PIPELINE_TIMEOUT_SECONDS=30.0
AUDIT_LOG_LEVEL=INFO
